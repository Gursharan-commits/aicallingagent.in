# ============================================================
# Voice AI Platform — environment variable template
# ============================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in every value below with your real credentials.
# 3. NEVER commit .env to source control.
#    It is already listed in .gitignore.
# ============================================================
# Non-secret settings (provider choices, models, thresholds)
# go in config.yaml — not here.
# ============================================================

# ── LiveKit ──────────────────────────────────────────────────
# Find these in your LiveKit Cloud project settings.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Deepgram STT (primary) ───────────────────────────────────
# https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── Sarvam AI (Hindi/Indic STT + TTS) ───────────────────────
# https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key

# ── Cartesia TTS (primary) ───────────────────────────────────
# https://play.cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key

# ── Gemini LLM (primary) ─────────────────────────────────────
# https://aistudio.google.com/app/apikey
# Both GEMINI_API_KEY and GOOGLE_API_KEY are accepted; set either or both.
GEMINI_API_KEY=your_gemini_api_key

# ── OpenAI (LLM fallback + TTS fallback) ────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# ── Twilio ───────────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Public HTTPS base URL for your telephony_bridge server.
# Used to build the WebSocket URL in /twiml responses.
# Example (ngrok):  https://abc123.ngrok.io
# Example (prod):   https://api.yourcompany.com
TWILIO_STREAM_URL=https://your_public_server_url

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
